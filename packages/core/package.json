{
  "name": "@khoralabs/obp-core",
  "version": "0.1.0",
  "description": "OBP foundation: errors, primitives, model, byte-stream; ./persistence and ./sqlite.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/open-binding-protocol.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/khoralabs/open-binding-protocol/tree/main/packages/core#readme",
  "bugs": "https://github.com/khoralabs/open-binding-protocol/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./persistence": {
      "types": "./src/persistence/core/index.ts",
      "import": "./src/persistence/core/index.ts",
      "default": "./src/persistence/core/index.ts"
    },
    "./sqlite": {
      "types": "./src/persistence/sqlite/index.ts",
      "import": "./src/persistence/sqlite/index.ts",
      "default": "./src/persistence/sqlite/index.ts"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@khoralabs/obp-nbc": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
