{
  "name": "@khoralabs/obp-wire",
  "version": "0.1.0",
  "description": "OBP wire: frame + session; ./http2 and ./ws transports.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/open-binding-protocol.git",
    "directory": "packages/wire"
  },
  "homepage": "https://github.com/khoralabs/open-binding-protocol/tree/main/packages/wire#readme",
  "bugs": "https://github.com/khoralabs/open-binding-protocol/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./http2": {
      "types": "./src/http2/index.ts",
      "import": "./src/http2/index.ts",
      "default": "./src/http2/index.ts"
    },
    "./ws": {
      "types": "./src/ws/index.ts",
      "import": "./src/ws/index.ts",
      "default": "./src/ws/index.ts"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@khoralabs/obp-core": "workspace:*",
    "@khoralabs/obp-nbc": "workspace:*",
    "@noble/curves": "^2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
