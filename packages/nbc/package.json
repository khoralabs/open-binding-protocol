{
  "name": "@khoralabs/obp-nbc",
  "version": "0.2.1",
  "description": "OBP Negotiated Binding Convention rules; ./bind-policy for expose-time schema checks.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/open-binding-protocol.git",
    "directory": "packages/nbc"
  },
  "homepage": "https://github.com/khoralabs/open-binding-protocol/tree/main/packages/nbc#readme",
  "bugs": "https://github.com/khoralabs/open-binding-protocol/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bind-policy": {
      "types": "./src/bind-policy/index.ts",
      "import": "./src/bind-policy/index.ts",
      "default": "./src/bind-policy/index.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@khoralabs/obp-core": "workspace:*",
    "ajv": "^8.17.1",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
